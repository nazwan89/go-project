# ============================================================
# Go Based Project — Environment Variable Reference
# ============================================================
# Copy this file to .env and fill in your values for local development.
# In production, set these variables through your hosting provider
# or container orchestration system (e.g., Docker, Kubernetes, Render).
#
# .env is gitignored — never commit real values to source control.
# ============================================================

# -------
# Application
# -------

# APP_NAME: Human-readable name for this application.
# Used in the Fiber app configuration (visible in logs and health responses).
# Default: go-project
APP_NAME=go-project

# TIMEZONE: IANA timezone string for timestamp formatting.
# Must be a valid tz database name (e.g., UTC, Asia/Kuala_Lumpur, America/New_York).
# Invalid values fall back to UTC automatically.
# Default: UTC
# Note: Phase 2 (OBS-04) will normalize all API response timestamps to UTC RFC3339.
TIMEZONE=UTC

# -------
# Server
# -------

# PORT: TCP port the HTTP server listens on.
# Default: 8080
PORT=8080
